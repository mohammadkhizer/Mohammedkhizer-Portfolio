# Environment Variables
# Copy this file to .env and fill in the values

# ===== MongoDB Configuration =====
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# ===== Admin Authentication & Security (Single Owner) =====
# The single authorized owner email address (rejects all other accounts)
ADMIN_EMAIL=work.mkhizer@gmail.com

# Auth.js / NextAuth secret key (generate with: openssl rand -base64 33)
AUTH_SECRET=generate-a-strong-32-byte-secret-here

# Google OAuth credentials (from Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Legacy admin session JWT secret fallback
JWT_SECRET=your-jwt-secret-key-here

# ===== Google AI (Genkit) =====
GOOGLE_GENAI_API_KEY=your-google-ai-api-key

# ===== Sentry (Error Tracking) =====
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/your-project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# ===== Gmail SMTP Email Service =====
GMAIL_USER=work.mkhizer@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
CONTACT_NOTIFICATION_EMAIL=work.mkhizer@gmail.com
NEXT_PUBLIC_APP_NAME=Mohammed Khizer Shaikh Portfolio
